option('profile', type: 'combo', choices: ['kernel', 'test', 'proof'], value: 'kernel', description: 'Debug-image workflow and metadata selection; kernel-core is shared')
option('lock_diag', type: 'combo', choices: ['auto', 'off', 'verify', 'trace', 'profile'], value: 'auto', description: 'kernel_debug.elf lock diagnostics provider level')
option('concurrency_diag', type: 'combo', choices: ['auto', 'off', 'snapshot', 'trace', 'watch', 'profile'], value: 'auto', description: 'kernel_debug.elf concurrency diagnostics provider level')
option('panic_probe', type: 'integer', value: 0, min: 0, max: 2, description: 'kernel_debug.elf panic probe selector')
option('scenario', type: 'combo', choices: ['off', 'ordinary', 'initrd', 'trap', 'remote', 'publication', 'report', 'dispatch', 'observer'], value: 'off', description: 'kernel_debug.elf test scenario selector')
option('build_id', type: 'string', value: 'auto', description: 'Image metadata only; does not select module objects')
option('qemu_smp', type: 'integer', value: 4, min: 1, description: 'Harts used by Meson QEMU run targets')
option('qemu_timeout', type: 'string', value: '10s', description: 'Host timeout used by Meson QEMU run targets')
# /*luna change: give the resilience proof its own host budget, reason: worker-terminal and child-close teardown may complete beyond the ordinary E1 boundary while the guest watchdog remains unchanged*/
option('qemu_resilience_timeout', type: 'string', value: '15s', description: 'Host timeout used by the resilience proof run')
# /*luna change: give the pressure proof its own watchdog budget, reason: the reduced eight-MiB page-fault workload must not share the ordinary E1 timeout*/
# The 2040-page stress pass needs a host observation window independent of E1.
option('qemu_pressure_timeout', type: 'string', value: '45s', description: 'Host timeout used by the proof pressure run')
# /*luna change: scale the pressure proof memory with its reduced fault workload, reason: the fixed boot footprint and child sponsorship spacing remain the same candidate while the run fits the existing watchdog*/
option('qemu_pressure_memory', type: 'string', value: '25M', description: 'QEMU RAM for the proof pressure run')
option('gdb_host', type: 'string', value: '127.0.0.1', description: 'GDB listener host for the debug run target')
option('gdb_port', type: 'integer', value: 1237, min: 1, max: 65535, description: 'GDB listener port for the debug run target')
